{
  "name": "lynerva",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "dotenv -e .env.local -- tsx src/db/migrate.ts",
    "db:migrate:runtime": "tsx src/db/migrate.ts",
    "db:studio": "dotenv -e .env.local -- drizzle-kit studio",
    "data:nflverse": "NODE_OPTIONS=--conditions=react-server dotenv -e .env.local -- tsx scripts/ingest-nflverse.ts",
    "smoke:auth": "tsx scripts/smoke-auth.ts",
    "smoke:live": "NODE_OPTIONS=--conditions=react-server tsx scripts/smoke-live.ts"
  },
  "dependencies": {
    "@libsql/client": "^0.18.0",
    "better-auth": "^1.7.5",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^1.47.0",
    "next": "16.3.5",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "resend": "^6.28.1",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^4.1.11",
    "dotenv-cli": "^11.0.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": "22.x"
  }
}
